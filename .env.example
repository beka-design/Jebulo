# =====================================================================
# JEBULO DIGITAL PRODUCT MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit .env, private keys, or API secrets to version control.
# =====================================================================

# Firebase Client Configuration (Public Web SDK)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Emulator Flags (set to "true" during local development)
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_AUTH_URL=http://localhost:9099
VITE_EMULATOR_FIRESTORE_HOST=localhost
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_FUNCTIONS_HOST=localhost
VITE_EMULATOR_FUNCTIONS_PORT=5001
VITE_EMULATOR_STORAGE_HOST=localhost
VITE_EMULATOR_STORAGE_PORT=9199

# Cloudinary Public Configuration (For public previews, avatars, thumbnails)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=gizay_public_uploads

# Backend Functions Configuration (Set via Firebase Functions Secrets or functions/.env)
# CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
# CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
# CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_signature
# MARKETPLACE_COMMISSION_RATE=0.12
# PROTECTED_FILE_STORAGE_BUCKET=your_protected_files_bucket
